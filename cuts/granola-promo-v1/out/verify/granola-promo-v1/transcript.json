 "segments": [
  {
   "start": 0.0,
   "end": 2.84,
   "text": "Instead of replacing my notes, it builds on them."
  },
  {
   "start": 3.02,
   "end": 5.82,
   "text": "Granola uses AI to review the entire conversation"
  },
  {
   "start": 5.82,
   "end": 8.64,
   "text": "and transcript, and it also transformed my notes"
  },
  {
   "start": 8.64,
   "end": 10.46,
   "text": "into a polished meeting summary."
  },
  {
   "start": 10.64,
   "end": 12.18,
   "text": "Now, right here, we can see that we finalized"
  },
  {
   "start": 12.18,
   "end": 14.08,
   "text": "on 12 chocolate chips and the cookies."
  },
  {
   "start": 14.64,
   "end": 17.46,
   "text": "We decided on adding sea salt, and right down here,"
  },
  {
   "start": 17.7,
   "end": 20.68,
   "text": "we landed on September 15th as our launch date."
  },
  {
   "start": 20.88,
   "end": 22.58,
   "text": "Three decisions in under 30 minutes."
  },
  {
   "start": 22.8,
   "end": 25.82,
   "text": "The black text is what I wrote before the meeting,"
  },
  {
   "start": 26.18,
   "end": 28.14,
   "text": "and here, the gray text is everything"
  },
  {
   "start": 28.14,
   "end": 32.82,
   "text": "granola generated from the conversation. Granola also labels who said what throughout the meeting."
  },
  {
   "start": 33.16,
   "end": 37.76,
   "text": "Right here under responsibilities, I can see what Elizabeth signed up for and here I can see"
  },
  {
   "start": 37.76,
   "end": 42.28,
   "text": "what I signed up for. Here I can simply hover over and on the right hand side, I'll click on"
  },
  {
   "start": 42.28,
   "end": 47.38,
   "text": "the magnifying glass and here I can see a transcript summary of the relevant part of the conversation."
  }
 ],
